# Phase 1B-I4-I1 — development-only Supabase adapter configuration.
# Never commit real credentials. Privileged credentials are server-only.
TATTOO_ENVIRONMENT=development
SUPABASE_URL=https://your-development-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-development-publishable-key
SUPABASE_SERVER_SECRET_KEY=replace-with-server-only-development-secret
SUPABASE_BUCKET_PUBLIC=tattoo-public-dev
SUPABASE_BUCKET_PRIVATE=tattoo-private-dev
SUPABASE_BUCKET_RESTRICTED=tattoo-restricted-dev
